# Copy this file to .env locally. Never commit the populated .env file.
# Use Supabase "Session pooler" (port 5432) for the long-running FastAPI container.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Backend-only Supabase credentials. Do not use NEXT_PUBLIC_ names here.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
# Optional legacy fallback for older Supabase projects:
# SUPABASE_ANON_KEY=legacy_anon_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

LLM_API_KEY=your_api_key_here
SECRET_KEY=your_secret_key
DOCUMENT_ENCRYPTION_KEY=REPLACE_WITH_A_44_CHARACTER_FERNET_KEY
